<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Usage Access is a special (appop-gated) permission. Declaring it is only half the
      story: it must be granted by hand in Settings > Special app access > Usage access,
      and device ownership does NOT grant it automatically. The app verifies the actual
      grant through AppOpsManager rather than assuming it.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Device-owner apps qualify for systemExempted; specialUse is the honest fallback
         used before provisioning, so Gate D can be measured without device ownership. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Requested, checked with canScheduleExactAlarms(), and degraded to an inexact
         alarm if refused. The alarm is defence in depth, never the primary mechanism. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
      Explicit package visibility for the finite target and browser lists. QUERY_ALL_PACKAGES
      is deliberately NOT requested: nothing here needs a device-wide app inventory.
    -->
    <queries>
        <!-- Metered targets -->
        <package android:name="com.instagram.android" />
        <package android:name="com.instagram.lite" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.zhiliaoapp.musically.go" />
        <package android:name="com.ss.android.ugc.trill" />
        <package android:name="com.reddit.frontpage" />

        <!-- Chrome: policy target, never suspended -->
        <package android:name="com.android.chrome" />

        <!-- YouTube: watched by the Shorts guard, suspended only while the guard is off -->
        <package android:name="com.google.android.youtube" />

        <!-- Hardcoded alternative browsers -->
        <package android:name="org.mozilla.firefox" />
        <package android:name="org.mozilla.firefox_beta" />
        <package android:name="org.mozilla.fenix" />
        <package android:name="org.mozilla.focus" />
        <package android:name="org.mozilla.klar" />
        <package android:name="com.brave.browser" />
        <package android:name="com.brave.browser_beta" />
        <package android:name="com.brave.browser_nightly" />
        <package android:name="com.microsoft.emmx" />
        <package android:name="com.microsoft.emmx.beta" />
        <package android:name="com.microsoft.emmx.dev" />
        <package android:name="com.microsoft.emmx.canary" />
        <package android:name="com.opera.browser" />
        <package android:name="com.opera.browser.beta" />
        <package android:name="com.opera.mini.native" />
        <package android:name="com.opera.mini.native.beta" />
        <package android:name="com.opera.gx" />
        <package android:name="com.sec.android.app.sbrowser" />
        <package android:name="com.sec.android.app.sbrowser.beta" />
        <package android:name="com.vivaldi.browser" />
        <package android:name="com.vivaldi.browser.snapshot" />
        <package android:name="com.duckduckgo.mobile.android" />
        <package android:name="org.torproject.torbrowser" />
        <package android:name="org.torproject.torbrowser_alpha" />
        <package android:name="com.chrome.beta" />
        <package android:name="com.chrome.dev" />
        <package android:name="com.chrome.canary" />
    </queries>

    <application
        android:name=".DoomStopApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DoomStop"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Device administrator. BIND_DEVICE_ADMIN is what stops any other app from
          impersonating this receiver; the system is the only permitted caller.
        -->
        <receiver
            android:name=".admin.LimiterAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!--
          systemExempted is the type a device-owner app qualifies for; specialUse is the
          honest pre-provisioning fallback so metering can be measured before any reset.
        -->
        <service
            android:name=".monitor.UsageMonitorService"
            android:exported="false"
            android:foregroundServiceType="systemExempted|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuous on-device metering of the user's own social-media usage against a locally configured daily limit, before device-owner provisioning grants the systemExempted type." />
        </service>

        <!--
          directBootAware so suspension can be re-applied before the first unlock. Only
          this receiver is direct-boot aware; nothing it touches before unlock reads
          credential-protected storage.
        -->
        <receiver
            android:name=".monitor.BootReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          Manifest package receivers cover the cold-start case. On modern Android most
          implicit broadcasts do not reach manifest receivers, so the monitor service ALSO
          registers these at runtime, where they do arrive. Behaviour on the target SDK is
          measured and recorded in the test report rather than assumed.
        -->
        <receiver
            android:name=".monitor.PackageChangeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- Backup enforcement deadline; only ever triggered by this app's own alarms. -->
        <receiver
            android:name=".monitor.DeadlineReceiver"
            android:exported="false" />

        <!--
          YouTube Shorts guard. BIND_ACCESSIBILITY_SERVICE means only the system can bind it,
          and the configuration limits it to events from the YouTube package. It has to be
          switched on by hand under Settings > Accessibility; while it is off, the
          coordinator suspends the whole YouTube app.
        -->
        <service
            android:name=".monitor.ShortsGuardService"
            android:exported="false"
            android:label="@string/shorts_guard_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/shorts_guard_service" />
        </service>

    </application>

</manifest>
