<resources>
    <!--
      The UI is Jetpack Compose; this theme only has to carry the window from launch to
      the first composition without a flash of the wrong colour.

      Parent is Theme.DeviceDefault.DayNight (there is no DayNight.NoActionBar variant in
      the platform), with the action bar switched off explicitly.
    -->
    <style name="Theme.DoomStop" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
